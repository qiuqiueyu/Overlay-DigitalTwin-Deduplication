    },
    {
      "id": "6a3BFNGaWzmh6Ov_iQrU_",
      "type": "rectangle",
      "x": 1011.4915866360043,
      "y": 6081.447660525418,
      "width": 1857.777709960938,
      "height": 1375.5556233723955,
      "angle": 0,
      "strokeColor": "#2f9e44",
